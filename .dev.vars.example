# Local secrets for `vinext dev` / `wrangler dev`, read through the Cloudflare `env` binding
# (lib/infrastructure/cloudflare-env.ts), not process.env — which is why this is a separate file
# from .env.example. Copy to `.dev.vars` (gitignored) and fill in what you need; both are optional.

# AI concierge — the room-search interpreter and voice transcription. Unset, search still answers
# through a deterministic keyword interpreter, and the mic reports transcription as unavailable
# rather than failing silently. See TECH.md's "AI concierge" section and README's Quick start.
OPENAI_API_KEY=sk-...

# Back-office sign-in (/admin/sign-in). Unset, the demo password "staysphere" applies and the
# sign-in page shows it; set both for anything reachable from outside. The secret signs the
# session cookie — any long random string. See TECH.md's "Sign-in" section.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-something-long-and-random

# Shared secret an inbound-email relay must send in `x-inbound-secret` for POST /api/inbound/email
# to file a guest's mail into /admin/communications. Unset, that route stays closed.
# INBOUND_EMAIL_SECRET=replace_me

# Vercel only (see TECH.md's "Hosting"): the database and file store that stand in for D1 and R2.
# On Vercel these are project environment variables, not .dev.vars; locally they let a
# `npm run build:vercel` output run against a file database, e.g. TURSO_DATABASE_URL=file:local.db.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=replace_me
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
