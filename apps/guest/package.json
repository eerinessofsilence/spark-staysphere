    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.18.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^3.2.7",
    "wrangler": "4.92.0"
  },
  "optionalDependencies": {
    "@oxlint/binding-linux-x64-gnu": "1.76.0",
    "@rolldown/binding-linux-x64-gnu": "1.0.1"
