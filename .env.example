# Nothing here is read by the app right now. It's the intended shape of production
# configuration (see TECH.md's "Storage model" and "Security and payments" sections), kept as a
# reference — not a checklist to fill in for local dev. Local dev needs no .env file at all:
# - D1 is a Cloudflare binding, not an env var — see .openai/hosting.json and TECH.md's
#   Persistence section. Nothing to configure locally.
# - The one real, currently-used secret (OPENAI_API_KEY, optional) goes in .dev.vars — see
#   .dev.vars.example — because it's read through the Cloudflare `env` binding
#   (lib/infrastructure/cloudflare-env.ts), not process.env.

# --- Future internal booking API ---
BOOKING_API_BASE_URL=http://localhost:3000/api

# --- Future PostgreSQL / Redis (see TECH.md's Storage model) ---
DATABASE_URL=postgresql://user:password@localhost:5432/staysphere
REDIS_URL=redis://localhost:6379

# --- Future object storage (R2/S3, for the CMS's not-yet-implemented upload path) ---
S3_ENDPOINT=https://example.r2.cloudflarestorage.com
S3_BUCKET=staysphere-assets
S3_ACCESS_KEY_ID=replace_me
S3_SECRET_ACCESS_KEY=replace_me

# --- Future providers — safe placeholders only ---
PMS_API_BASE_URL=https://pms.example.com
PMS_API_KEY=replace_me
PAYMENT_PROVIDER_MODE=demo
PAYMENT_PROVIDER_PUBLIC_KEY=replace_me
PAYMENT_PROVIDER_SECRET_KEY=replace_me
CRM_WEBHOOK_URL=https://crm.example.com/webhooks/staysphere
